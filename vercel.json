{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "ko-hirlevel-archivum",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/level/:id",
      "destination": "/level/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/hirlevel-megerosites/",
      "destination": "/hirlevel-megerosites",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/data/(.*)\\.json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, s-maxage=600"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
